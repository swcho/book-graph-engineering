@prefix ex:   <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# --- 낱말의 뜻 (스키마) ---
ex:Company   a rdfs:Class .
ex:Contract  a rdfs:Class .
ex:Person    a rdfs:Class .

ex:signed    a rdfs:Property ; rdfs:domain ex:Company ; rdfs:range ex:Contract .
ex:terminated a rdfs:Property ; rdfs:domain ex:Company ; rdfs:range ex:Contract .
ex:managedBy a rdfs:Property ; rdfs:domain ex:Company ; rdfs:range ex:Person .
ex:parentOf  a rdfs:Property ; rdfs:domain ex:Company ; rdfs:range ex:Company .

# 자회사의 자회사도 자회사다 (이행성). OWL 이 실제로 일을 하는 지점.
ex:parentOf a owl:TransitiveProperty .

# --- 사실 ---
ex:GaonTech  a ex:Company ; rdfs:label "가온테크" ;
             ex:terminated ex:M2021077 ;
             ex:signed     ex:C2025118 ;
             ex:managedBy  ex:KimHaneul ;
             ex:parentOf   ex:GaonSoft .

ex:GaonSoft  a ex:Company ; rdfs:label "가온소프트" ;
             ex:parentOf ex:GaonLab .

ex:GaonLab   a ex:Company ; rdfs:label "가온연구소" .

ex:NaruSoft  a ex:Company ; rdfs:label "나루소프트" ;
             ex:signed ex:C2025004 .

ex:M2021077 a ex:Contract ; ex:endedOn "2024-03-11"^^xsd:date .
ex:C2025118 a ex:Contract ; ex:startedOn "2025-06-02"^^xsd:date .
ex:C2025004 a ex:Contract ; ex:startedOn "2025-01-20"^^xsd:date .

ex:KimHaneul a ex:Person ; rdfs:label "김하늘" .
